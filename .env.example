# Copy to .env. Use your own strong random values; never use these placeholders.
PORTSCOPE_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_DASHBOARD_PASSWORD
PORTSCOPE_SESSION_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
# Set 1 only if you serve the dashboard over HTTPS (reverse proxy).
PORTSCOPE_SECURE_COOKIES=0
